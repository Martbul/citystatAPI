model Rank {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int      @default(0)
  level     Level    @default(Iron)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ranks")
}


model Friend {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  friendId  String  @map("friend_id")
  firstName String?
  lastName  String?
  userName  String
  imageUrl  String?
  city      String?

  user   User @relation("FriendsFromUser", fields: [userId], references: [id])
  friend User @relation("FriendsToUser", fields: [friendId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@map("user_friends")
}

model CityStat {
  id        String   @id @default(cuid())
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalStreetsCovered    Int     @default(0)
  totalKilometersCovered Float   @default(0)
  cityCoveragePercentage Float   @default(0)
  totalDaysActive        Int     @default(0)
  curentStreakDays       Int     @default(0)
  longestStreakDays      Int     @default(0)
  averageDailyDistance   Float   @default(0)
  averageSessionTime    Int     @default(0) // in seconds
  totalSessions          Int     @default(0)
  totalTimeSpent        Int     @default(0) // in seconds
  averageSpeed           Float   @default(0) // in km/h
  favoriteStreet         String? // street name
  @@map("city_stats")
}

model VisitedStreet {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  sessionId       String   @map("session_id")
  streetId        String   @map("street_id")
  streetName      String   @map("street_name")
  entryTimestamp  BigInt   @map("entry_timestamp")
  exitTimestamp   BigInt?  @map("exit_timestamp")
  durationSeconds Int?     @map("duration_seconds")
  entryLatitude   Decimal  @map("entry_latitude") @db.Decimal(10, 8)
  entryLongitude  Decimal  @map("entry_longitude") @db.Decimal(11, 8)
  createdAt       DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([sessionId])
  @@index([streetId])
  @@index([entryTimestamp])
  @@index([userId, streetId]) // Composite index for efficient visit count queries
  @@map("visited_streets")
}


//! merdge StreetVisitStat VisitedStreet

// New model to track street visit statistics
model StreetVisitStat {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  streetId          String   @map("street_id")
  streetName        String   @map("street_name")
  visitCount        Int      @default(1) @map("visit_count")
  firstVisit        BigInt   @map("first_visit")
  lastVisit         BigInt   @map("last_visit")
  totalTimeSpent    Int      @default(0) @map("total_time_spent") // Total seconds spent on this street
  averageTimeSpent  Int      @default(0) @map("average_time_spent") // Average seconds per visit
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, streetId]) // Ensure one stat record per user per street
  @@index([userId])
  @@index([streetId])
  @@index([visitCount])
  @@index([totalTimeSpent])
  @@map("street_visit_stats")
}

model Settings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme                            Theme             @default(LIGHT)
  language                         Language          @default(En)
  enabledLocationTracking          Boolean           @default(false)
  allowCityStatDataUsage           Boolean           @default(true)
  allowDataPersonalizationUsage    Boolean           @default(true)
  allowInAppRewards                Boolean           @default(true)
  allowDataAnaliticsAndPerformance Boolean           @default(true)
  allDevices                       Device[]
  textSize                         TextSize          @default(MEDIUM)
  zoomLevel                        String            @default("100")
  fontStyle                        String            @default("default")
  messagesAllowance                MessagesAllowance @default(ALLMSG)
  showRoleColors                   RoleColors        @default(NEXTTONAME)
  motion                           Motion            @default(DONTPLAYGIFWHENPOSSIBLESHOW)
  stickersAnimation                StickersAnimation @default(ALWAYS)
  enableInAppNotifications         Boolean           @default(true)
  enableSoundEffects               Boolean           @default(true)
  enableVibration                  Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Device {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Settings     Settings? @relation(fields: [settingsId], references: [id])
  settingsId   String?
  name         String
  location     String
  lastLoggedIn DateTime
}

enum Level {
  Iron
  Bronze
  Silver
  Gold
  Dimond
  Platinum
  Master  
}

enum Language {
  En
  Es
  Fr
  De
  Zh
  Ja
  Ru
  Bg
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum RoleColors {
  NEXTTONAME
  INNAME
  DONTSHOW
  SYNCPROFILECOLORS
}

enum Motion {
  REDUCEDMOTION
  SYNCWITHDEVICE
  DONTPLAYGIFWHENPOSSIBLESHOW
  PLAYEMOJIES
}

enum StickersAnimation {
  ALWAYS
  ONINTERACTION
  NEVER
}

enum MessagesAllowance {
  ALLMSG
  UNREADMAS
  HIDE
}

enum Status {
  ACTIVE
  SLEEP
  OFFLINE
  BANNED
  PENDING
  IDLE
  INVISIBLE
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum TextSize {
  BIG
  MEDIUM
  SMALL
}
